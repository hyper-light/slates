diff --git a/crates/server/src/repository/store_tests.rs b/crates/server/src/repository/store_tests.rs
index 0d254cf2b..7d4227b80 100644
--- a/crates/server/src/repository/store_tests.rs
+++ b/crates/server/src/repository/store_tests.rs
@@ -1276,3 +1276,177 @@ fn a_subversion_copy_from_a_stored_revision_reads_a_window_that_was_let_go() {
   assert_eq!(committed, Ok(3));
   assert_eq!(copied.as_deref(), Some(first.as_slice()));
