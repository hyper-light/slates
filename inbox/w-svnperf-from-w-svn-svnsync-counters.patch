+/// The daemon's `vcs*` and `content*` counters (`status --json`, each shard's `refusals`), summed over its shards by
+/// name: what [`an_svnsync_measured`] prints after each leg, so a measurement reads where a revision's time went (the
+/// store's text reads, pieces fetched through the node's store, texts brought back).
+#[cfg(unix)]
+fn vcs_counters(instance: &str) -> std::collections::BTreeMap<String, u64> {
+  let (_, out, _) = slates(instance, &["status", "--json"]);
+  let status: serde_json::Value = serde_json::from_str(&out).unwrap_or_default();
+  let mut counters = std::collections::BTreeMap::new();
+  for report in status["shards"].as_array().into_iter().flatten() {
+    for counter in report["refusals"].as_array().into_iter().flatten() {
+      let (Some(kind), Some(count)) = (counter["kind"].as_str(), counter["count"].as_u64()) else {
+        continue;
+      };
+      if kind.starts_with("vcs") || kind.starts_with("content") {
+        *counters.entry(kind.to_owned()).or_insert(0) += count;
+      }
+    }
+  }
+  counters
+}
+
+/// What each counter of `after` gained over `before`, divided by `revisions`: a leg's counters a revision, those that
+/// moved alone.
+#[cfg(unix)]
+fn counters_added(
+  before: &std::collections::BTreeMap<String, u64>,
+  after: &std::collections::BTreeMap<String, u64>,
+  revisions: f64,
+) -> Vec<String> {
+  after
+    .iter()
+    .filter_map(|(kind, count)| {
+      let added = count.saturating_sub(before.get(kind).copied().unwrap_or(0));
+      (added > 0).then(|| format!("{kind}={:.2}", added as f64 / revisions))
+    })
+    .collect()
+}
