//! A pack entry's header (A-582 part 3; §4.17.2 piece 2, "a pack entry's header"): what an entry holds, how long it is,
//! and for a delta which base it applies to. From git's `gitformat-pack.adoc` (v2.50.1, read 2026-11-19): an entry is
//! "n-byte type and length (3-bit type, (n-1)*7+4-bit length)", then a REF_DELTA's "base object name" or an
//! OFS_DELTA's "negative relative offset from the delta object's position in the pack" (lines 51-66); the types (70-81);
//! the size encoding, seven bits a byte with later bytes more significant (83-93); and the offset encoding, whose bytes
//! after the first each add 2^7, 2^14, and so on (257-262) [B]. And git's `packfile.c`, `unpack_object_header_buffer`
//! (1116-1139) and `get_delta_base` (1238-1277) [C], which clients run, followed where the document leaves room.
//!
//! [`read`] reads one header from the bytes a pack stream has delivered so far, `None` until its last byte arrives, so
//! the pack reader (§4.17.2 piece 3) reads each entry as it comes; [`write`] writes one as git's `pack-objects` does,
//! each number in the fewest bytes. Nothing here allocates: a REF_DELTA's base name is borrowed from the input.
//!
//! **Hostile input (§4.9).** Every byte is untrusted. Type 0 (invalid) and 5 (reserved) are refused as soon as the first
//! byte arrives (`Type`). A size is read as git reads it on a 64-bit word: `unpack_object_header_buffer` refuses a group
//! once its shift passes the word less seven bits ("bad object header"), so a size stops at 60 bits (`SizeTooLong`). An
//! offset whose next group would lose bits is refused as git refuses it ("overflow", `OffsetTooLong`). An OFS_DELTA must
//! name an entry before its own: an offset of zero names the entry itself (`BaseNotBefore`), and one that puts the base
//! before the pack's first entry, inside its twelve-byte header or before the pack begins, is `BaseBeforePack`. git
//! refuses only a base at or before byte zero ("out of bound"); no entry begins inside the header either.

use crate::out::Out;

/// Format: a pack's header, the signature `PACK`, a version and the number of objects, four bytes each
/// (`gitformat-pack.adoc` 36-49). The first entry begins here, so no entry, and no delta's base, begins before it.
pub const PACK_HEADER_LEN: u64 = 12;

/// Format: the bit of each byte of a header's numbers that says another byte follows (`gitformat-pack.adoc` 83-93 and
/// 257-262).
const MORE: u8 = 0x80;

/// Format: the seven bits of a number each byte carries after the first byte of a size, and in every byte of an offset.
const GROUP: u8 = 0x7f;

/// Format: the bits one group carries.
const GROUP_BITS: u32 = 7;

/// Format: the size's first bits, the first byte's low four ("(n-1)*7+4-bit length", `gitformat-pack.adoc` 55).
const FIRST_SIZE: u8 = 0x0f;

/// Format: how many bits the first byte gives the size, below the type's three.
const FIRST_SIZE_BITS: u32 = 4;

/// Format: the type's three bits, once shifted down past the size's four (`gitformat-pack.adoc` 55).
const TYPE_BITS: u8 = 0x07;

/// Format: the largest shift git reads a size's group at on a 64-bit word: `unpack_object_header_buffer` refuses a group
/// when "(bitsizeof(long) - 7) < shift" (`packfile.c` 1128), so a size has at most 60 bits.
const SIZE_SHIFT_MAX: u32 = u64::BITS.saturating_sub(GROUP_BITS);

/// Derived: the bits a size git reads can have, 60: the first byte's four, and seven for each shift git reads a group at,
/// from four up to [`SIZE_SHIFT_MAX`].
const SIZE_BITS: u32 = FIRST_SIZE_BITS.saturating_add(
  GROUP_BITS.saturating_mul(
    SIZE_SHIFT_MAX
      .saturating_sub(FIRST_SIZE_BITS)
      .saturating_div(GROUP_BITS)
      .saturating_add(1),
  ),
);

/// Format: `OBJ_COMMIT`'s code (`gitformat-pack.adoc` 74).
const OBJ_COMMIT: u8 = 1;

/// Format: `OBJ_TREE`'s code (`gitformat-pack.adoc` 75).
const OBJ_TREE: u8 = 2;

/// Format: `OBJ_BLOB`'s code (`gitformat-pack.adoc` 76).
const OBJ_BLOB: u8 = 3;

/// Format: `OBJ_TAG`'s code (`gitformat-pack.adoc` 77).
const OBJ_TAG: u8 = 4;

/// Format: `OBJ_OFS_DELTA`'s code (`gitformat-pack.adoc` 78).
const OBJ_OFS_DELTA: u8 = 6;

/// Format: `OBJ_REF_DELTA`'s code (`gitformat-pack.adoc` 79).
const OBJ_REF_DELTA: u8 = 7;

/// Format: a SHA-1 object name's bytes, twenty.
const SHA1_NAME_LEN: usize = 20;

/// Format: a SHA-256 object name's bytes, thirty-two.
const SHA256_NAME_LEN: usize = 32;

/// Format: the most bytes an offset takes: nine groups of seven bits reach past 63, and git refuses the tenth.
const OFFSET_BYTES_MAX: usize = 10;

/// The hash a repository names its objects by, as its `object-format` announces (§4.17.2): what decides how long a
/// REF_DELTA's base name is.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum ObjectFormat {
  /// SHA-1, a twenty-byte name.
  Sha1,
  /// SHA-256, a thirty-two-byte name.
  Sha256,
}

impl ObjectFormat {
  /// The bytes of one object name.
  pub const fn name_len(self) -> usize {
    match self {
      ObjectFormat::Sha1 => SHA1_NAME_LEN,
      ObjectFormat::Sha256 => SHA256_NAME_LEN,
    }
  }
}

/// What an entry holds.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Kind<'a> {
  /// A commit, whole.
  Commit,
  /// A tree, whole.
  Tree,
  /// A blob, whole.
  Blob,
  /// An annotated tag, whole.
  Tag,
  /// A delta against the entry that begins `base` bytes into the same pack.
  OfsDelta {
    /// Where the base's entry begins in the pack.
    base: u64,
  },
  /// A delta against the object named `base`, in the same pack or, in a thin pack, the receiver's store.
  RefDelta {
    /// The base's name, as many bytes as the pack's object format names an object with.
    base: &'a [u8],
  },
}

/// A pack entry's header.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Header<'a> {
  /// What the entry holds.
  pub kind: Kind<'a>,
  /// The bytes the entry's compressed data inflates to: the object's for a whole object, the delta's for a delta.
  pub size: u64,
}

/// Why bytes are not a pack entry's header, or a header cannot be written. Each names where its entry begins in the
/// pack.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum Refusal {
  /// Type 0, which is invalid, or 5, reserved for future expansion (`gitformat-pack.adoc` 70-81).
  Type {
    /// Where the entry begins.
    at: u64,
    /// The type code.
    code: u8,
  },
  /// A size past the 60 bits git reads (`packfile.c` 1128, "bad object header").
  SizeTooLong {
    /// Where the entry begins.
    at: u64,
  },
  /// An OFS_DELTA's offset past 64 bits (`packfile.c` 1259, "overflow").
  OffsetTooLong {
    /// Where the entry begins.
    at: u64,
  },
  /// An OFS_DELTA's offset of zero, which names the entry itself rather than one before it.
  BaseNotBefore {
    /// Where the entry begins.
    at: u64,
  },
  /// An OFS_DELTA's offset that puts its base before the pack's first entry: inside the pack's header, or before the
  /// pack begins (`packfile.c` 1265, "out of bound").
  BaseBeforePack {
    /// Where the entry begins.
    at: u64,
    /// The offset back from it.
    offset: u64,
  },
}

/// Reads the header of the entry the start of `bytes` holds, which begins `at` bytes into its pack, whose objects are
/// named in `format`: the header and the bytes it took. `None` while `bytes` holds less than the whole header, so a reader
/// takes more and asks again; refused when no more bytes could make it one.
pub fn read(
  bytes: &[u8],
  at: u64,
  format: ObjectFormat,
) -> Result<Option<(Header<'_>, usize)>, Refusal> {
  let Some((code, size, took)) = type_and_size(bytes, at)? else {
    return Ok(None);
  };
  let rest = bytes.get(took..).unwrap_or_default();
  let (kind, more) = match code {
    OBJ_COMMIT => (Kind::Commit, 0),
    OBJ_TREE => (Kind::Tree, 0),
    OBJ_BLOB => (Kind::Blob, 0),
    OBJ_TAG => (Kind::Tag, 0),
    OBJ_OFS_DELTA => match base_offset(rest, at)? {
      Some((base, more)) => (Kind::OfsDelta { base }, more),
      None => return Ok(None),
    },
    OBJ_REF_DELTA => match rest.get(..format.name_len()) {
      Some(base) => (Kind::RefDelta { base }, format.name_len()),
      None => return Ok(None),
    },
    code => return Err(Refusal::Type { at, code }),
  };
  Ok(Some((Header { kind, size }, took.saturating_add(more))))
}

/// The type code, the size and the bytes they took, `None` until the size's last byte arrives. An invalid or reserved
/// type is refused from the first byte, whatever follows.
fn type_and_size(bytes: &[u8], at: u64) -> Result<Option<(u8, u64, usize)>, Refusal> {
  let Some(&first) = bytes.first() else {
    return Ok(None);
  };
  let code = first.checked_shr(FIRST_SIZE_BITS).unwrap_or(0) & TYPE_BITS;
  if !matches!(
    code,
    OBJ_COMMIT | OBJ_TREE | OBJ_BLOB | OBJ_TAG | OBJ_OFS_DELTA | OBJ_REF_DELTA
  ) {
    return Err(Refusal::Type { at, code });
  }
  let mut size = u64::from(first & FIRST_SIZE);
  let mut shift = FIRST_SIZE_BITS;
  let mut took = 1usize;
  let mut byte = first;
  while byte & MORE != 0 {
    if shift > SIZE_SHIFT_MAX {
      return Err(Refusal::SizeTooLong { at });
    }
    let Some(&next) = bytes.get(took) else {
      return Ok(None);
    };
    byte = next;
    took = took.saturating_add(1);
    // `shift` is at most `SIZE_SHIFT_MAX`, so the group's seven bits stay inside the word.
    size |= u64::from(byte & GROUP).checked_shl(shift).unwrap_or(0);
    shift = shift.saturating_add(GROUP_BITS);
  }
  Ok(Some((code, size, took)))
}

/// An OFS_DELTA's base, read from the start of `bytes` for the entry that begins `at` into its pack: where the base's
/// entry begins and the bytes the offset took, `None` until its last byte arrives. Each byte after the first adds one
/// before its shift, as the offset encoding does (`gitformat-pack.adoc` 257-262; `packfile.c` 1257-1263).
fn base_offset(bytes: &[u8], at: u64) -> Result<Option<(u64, usize)>, Refusal> {
  let Some(&first) = bytes.first() else {
    return Ok(None);
  };
  let mut offset = u64::from(first & GROUP);
  let mut took = 1usize;
  let mut byte = first;
  while byte & MORE != 0 {
    offset = offset
      .checked_add(1)
      .ok_or(Refusal::OffsetTooLong { at })?;
    if offset.checked_shr(SIZE_SHIFT_MAX).unwrap_or(0) != 0 {
      return Err(Refusal::OffsetTooLong { at });
    }
    let Some(&next) = bytes.get(took) else {
      return Ok(None);
    };
    byte = next;
    took = took.saturating_add(1);
    offset = offset.checked_shl(GROUP_BITS).unwrap_or(0) | u64::from(byte & GROUP);
  }
  base_before(at, offset).map(|base| Some((base, took)))
}

/// The base an offset back from the entry at `at` names: refused when it names the entry itself or begins before the
/// pack's first entry.
fn base_before(at: u64, offset: u64) -> Result<u64, Refusal> {
  if offset == 0 {
    return Err(Refusal::BaseNotBefore { at });
  }
  at.checked_sub(offset)
    .filter(|base| *base >= PACK_HEADER_LEN)
    .ok_or(Refusal::BaseBeforePack { at, offset })
}

/// Writes `header`, for the entry that begins `at` bytes into its pack, as git's `pack-objects` writes one: the type and
/// the size in the fewest bytes, then a REF_DELTA's base name, or an OFS_DELTA's offset back to its base in the fewest
/// bytes. Refused, nothing written, for a size past what git reads and for a base not before the entry and after the
/// pack's header.
pub fn write(header: &Header<'_>, at: u64, out: &mut impl Out) -> Result<(), Refusal> {
  if header.size.checked_shr(SIZE_BITS).unwrap_or(0) != 0 {
    return Err(Refusal::SizeTooLong { at });
  }
  let (code, offset) = match header.kind {
    Kind::Commit => (OBJ_COMMIT, None),
    Kind::Tree => (OBJ_TREE, None),
    Kind::Blob => (OBJ_BLOB, None),
    Kind::Tag => (OBJ_TAG, None),
    Kind::OfsDelta { base } => {
      let offset = at.checked_sub(base).unwrap_or(0);
      base_before(at, offset)?;
      (OBJ_OFS_DELTA, Some(offset))
    }
    Kind::RefDelta { .. } => (OBJ_REF_DELTA, None),
  };
  write_type_and_size(code, header.size, out);
  if let Some(offset) = offset {
    write_offset(offset, out);
  }
  if let Kind::RefDelta { base } = header.kind {
    out.put(base);
  }
  Ok(())
}

/// Writes a type and a size: the type above the size's low four bits in the first byte, then seven bits a byte.
fn write_type_and_size(code: u8, size: u64, out: &mut impl Out) {
  let low = u8::try_from(size & u64::from(FIRST_SIZE)).unwrap_or(0);
  let mut rest = size.checked_shr(FIRST_SIZE_BITS).unwrap_or(0);
  let typed = code.checked_shl(FIRST_SIZE_BITS).unwrap_or(0) | low;
  out.put(&[if rest == 0 { typed } else { typed | MORE }]);
  while rest != 0 {
    let group = u8::try_from(rest & u64::from(GROUP)).unwrap_or(0);
    rest = rest.checked_shr(GROUP_BITS).unwrap_or(0);
    out.put(&[if rest == 0 { group } else { group | MORE }]);
  }
}

/// Writes an offset as git's `pack-objects` does (`builtin/pack-objects.c`, `write_no_reuse_object`): its last group
/// first in place, then each earlier byte one less than its value, so the reader's added one gives it back.
fn write_offset(offset: u64, out: &mut impl Out) {
  let mut bytes = [0u8; OFFSET_BYTES_MAX];
  let mut first = OFFSET_BYTES_MAX.saturating_sub(1);
  let mut rest = offset;
  if let Some(last) = bytes.get_mut(first) {
    *last = u8::try_from(rest & u64::from(GROUP)).unwrap_or(0);
  }
  rest = rest.checked_shr(GROUP_BITS).unwrap_or(0);
  while rest != 0 {
    rest = rest.saturating_sub(1);
    first = first.saturating_sub(1);
    if let Some(byte) = bytes.get_mut(first) {
      *byte = MORE | u8::try_from(rest & u64::from(GROUP)).unwrap_or(0);
    }
    rest = rest.checked_shr(GROUP_BITS).unwrap_or(0);
  }
  out.put(bytes.get(first..).unwrap_or_default());
}

/// The bytes `header` takes when written for the entry at `at`, or why it cannot be.
pub fn written_len(header: &Header<'_>, at: u64) -> Result<u64, Refusal> {
  let mut measure = crate::out::Measure::default();
  write(header, at, &mut measure)?;
  Ok(measure.0)
}

