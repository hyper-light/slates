+/// Main 01a20182's ruling of 2026-11-24 (w-hg's sweep: a write path's bring-back never let go; its red for a holder's
+/// replica build, `replica_build::drive`). Do: on a three-node `f = 1` fleet with a git repository on a, push `main`,
+/// then two new branches, `first` and `second` (each green, and each holder's replica of it, owing its push, P2); push a
+/// commit on top of `first`, so each holder builds its replica of `first` and with it makes its store of the repository
+/// (`vcs_store::replica`, made at a holder's first build); let go every window b and c hold, their homes told first
+/// (`Daemon::let_go_vcs_windows`); then push a commit on top of `second`, so a holder builds its replica of `second`
+/// over its store's let-go windows. Expect: every push lands; a holder made that replica (`merge.replica_build.made`)
+/// and brought windows back to build it (so it is the bring-back this measures); and that holder holds none of the
+/// windows it let go once the build ended (`vcs_store.read_through.write_path_let_go`). Red before: the windows it
+/// brought back stayed held. (Found writing it: let go before any build, or with a holder's homed pack pinned, nothing
+/// was brought back, and the test measured nothing.)
+#[test]
+fn a_holders_replica_build_lets_go_the_windows_it_brought_back_once_it_is_made() {
+  let _serial = serialize_fleet_tests();
+  let fleet = git_fleet("replica-brought-back");
+  let main = fleet.push(0, ("main.txt", b"main's first history\n"));
+  let first = fleet.push_to(0, ("first.txt", b"a first branch's own history\n"), "first");
+  let second = fleet.push_to(
+    0,
+    ("second.txt", b"a second branch's own history\n"),
+    "second",
+  );
+  let made = fleet.push_on_top_of(
+    0,
+    ("first-2.txt", b"the first branch's second version\n"),
+    "first",
+  );
+  let (builds, over) = built_over_let_go(&fleet, "second");
+  fleet.stop();
+  eprintln!("replica builds over let-go windows: {builds:?}");
+  assert_eq!(
+    (main, first, second, made, over),
+    (Ok(()), Ok(()), Ok(()), Ok(()), Ok(())),
+    "every push landed"
+  );
+  let built = builds
+    .iter()
+    .find(|build| build.made > 0 && build.brought_back > 0)
+    .unwrap_or_else(|| {
+      panic!("a holder built its replica over windows it brought back: {builds:?}")
+    });
+  assert_eq!(
+    built.held_after, 0,
+    "the windows it brought back let go again once it was made: {built:?}"
+  );
+}
