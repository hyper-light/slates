+/// What a holder's replica build did over windows let go first: the windows let go, the replicas made, the windows
+/// brought back and those let go again at the build's end, and the let-go windows held after.
+#[derive(Debug, Default)]
+struct HolderBuild {
+  let_go: usize,
+  made: u64,
+  brought_back: u64,
+  let_go_again: u64,
+  held_after: usize,
+}
+
+/// Node `node`'s replica builds made, windows brought back and windows a write path let go again.
+fn holder_build_counts(fleet: &GitFleet, node: usize) -> (u64, u64, u64) {
+  let count = |name: &str| refusal_count(&fleet.daemons[node], name).unwrap_or(0);
+  (
+    count("merge.replica_build.made"),
+    count("vcs_store.read_through.brought_back"),
+    count("vcs_store.read_through.write_path_let_go"),
+  )
+}
+
+/// On each holder (b and c), its windows let go; then a commit pushed on top of branch `branch` through a, so each
+/// holder builds its owing replica of the branch over what it let go; waited for until one has made it. Each holder's
+/// [`HolderBuild`], and the push's answer.
+fn built_over_let_go(fleet: &GitFleet, branch: &str) -> (Vec<HolderBuild>, Result<(), String>) {
+  let let_go: Vec<Vec<slates_vcs::ContentId>> = (1..3)
+    .map(|node| fleet.daemons[node].let_go_vcs_windows().unwrap_or_default())
+    .collect();
+  let before: Vec<(u64, u64, u64)> = (1..3)
+    .map(|node| holder_build_counts(fleet, node))
+    .collect();
+  let pushed = fleet.push_on_top_of(
+    0,
+    ("second-2.txt", b"the second branch's second version\n"),
+    branch,
+  );
+  let observed: Vec<&Daemon> = fleet.daemons.iter().collect();
+  let _ = poll_until(&observed, PLACEMENT_DEADLINE, || {
+    Ok((1..3).any(|node| holder_build_counts(fleet, node).0 > before[node - 1].0))
+  });
+  let builds = (1..3)
+    .map(|node| {
+      let after = holder_build_counts(fleet, node);
+      let at = node - 1;
+      HolderBuild {
+        let_go: let_go[at].len(),
+        made: after.0 - before[at].0,
+        brought_back: after.1 - before[at].1,
+        let_go_again: after.2 - before[at].2,
+        held_after: fleet.daemons[node]
+          .vcs_windows_held(&let_go[at])
+          .unwrap_or(usize::MAX),
+      }
+    })
+    .collect();
+  (builds, pushed)
+}
