+  /// Test support (main 01a20182's ruling of 2026-11-24: a write path's bring-back lets go at its owner's end): lets go
+  /// every window each of this node's shards' version-control content stores holds, as a landed pack's let-go lets one
+  /// go: each content's home here told first (`vcs_store::homes::landed_pack_here`, so a pack homed on this node is not
+  /// pinned), each marked landed, then let go (`vcs_store::let_go_read`): the windows let go, for
+  /// [`Daemon::vcs_windows_held`] to ask after. The typed refusal when a shard could not answer.
+  pub fn let_go_vcs_windows(&self) -> Result<Vec<slates_vcs::ContentId>, ObserveError> {
+    let mut let_go = Vec::new();
+    for shard in self.shards.clone() {
+      let_go.extend(self.observe(Some(shard), |state| {
+        let ids: Vec<slates_vcs::ContentId> = state
+          .vcs_stores
+          .content()
+          .map(|content| content.identities().copied().collect())
+          .unwrap_or_default();
+        for id in &ids {
+          crate::vcs_store::homes::landed_pack_here(state, *id);
+        }
+        crate::vcs_store::within_budget(state, 0, |stores| {
+          if let Some(content) = stores.content_mut() {
+            for id in &ids {
+              content.mark_landed(id);
+            }
+          }
+        });
+        ids
+          .into_iter()
+          .filter(|id| crate::vcs_store::let_go_read(state, id).is_ok())
+          .collect::<Vec<_>>()
+      })?);
+    }
+    Ok(let_go)
+  }
+
+  /// Test support: how many of `windows` this node's shards' version-control content stores hold now (not let go).
+  pub fn vcs_windows_held(&self, windows: &[slates_vcs::ContentId]) -> Result<usize, ObserveError> {
+    let mut held = 0;
+    for shard in self.shards.clone() {
+      let windows = windows.to_vec();
+      held += self.observe(Some(shard), move |state| {
+        state.vcs_stores.content().map_or(0, |content| {
+          let present: std::collections::BTreeSet<&slates_vcs::ContentId> =
+            content.identities().collect();
+          windows
+            .iter()
+            .filter(|window| present.contains(window) && !content.is_away(window))
+            .count()
+        })
+      })?;
+    }
+    Ok(held)
+  }
