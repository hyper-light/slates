From d3afb20dcbd7790dafc7e465e58bc57cf72e4550 Mon Sep 17 00:00:00 2001
From: Ada Lundhe <adalundhe@lundhe.audio>
Date: Wed, 18 Nov 2026 07:03:57 -0800
Subject: [PATCH 2/2] sys: volinfo: FILE_SUPPORTS_HARD_LINKS for a volume that
 declares HardLinks

With FileLinkInformation forwarded to such a volume (the previous commit), the volume's attributes say so, as NTFS's
do; GetVolumeInformation's FILE_SUPPORTS_HARD_LINKS is what programs read before they link.
---
 src/sys/driver.h  | 3 +++
 src/sys/volinfo.c | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/sys/driver.h b/src/sys/driver.h
index b55365a5..8609a128 100644
--- a/src/sys/driver.h
+++ b/src/sys/driver.h
@@ -2051,6 +2051,9 @@ typedef struct
 } FSP_FILE_LINK_INFORMATION_EX, *PFSP_FILE_LINK_INFORMATION_EX;
 #define FSP_FILE_LINK_POSIX_SEMANTICS           0x00000002
 #define FSP_FILE_LINK_IGNORE_READONLY_ATTRIBUTE 0x00000040
+#if !defined(FILE_SUPPORTS_HARD_LINKS)
+#define FILE_SUPPORTS_HARD_LINKS                0x00400000
+#endif
 
 /* FILE_STAT_INFORMATION and FILE_STAT_LX_INFORMATION are missings on some WDK's. */
 typedef struct
diff --git a/src/sys/volinfo.c b/src/sys/volinfo.c
index 93d2ec5f..934afd23 100644
--- a/src/sys/volinfo.c
+++ b/src/sys/volinfo.c
@@ -99,7 +99,7 @@ static NTSTATUS FspFsvolQueryFsAttributeInformation(
         (FsvolDeviceExtension->VolumeParams.PersistentAcls ? FILE_PERSISTENT_ACLS : 0) |
         (FsvolDeviceExtension->VolumeParams.ReparsePoints ? FILE_SUPPORTS_REPARSE_POINTS : 0) |
         (FsvolDeviceExtension->VolumeParams.NamedStreams ? FILE_NAMED_STREAMS : 0) |
-        //(FsvolDeviceExtension->VolumeParams.HardLinks ? FILE_SUPPORTS_HARD_LINKS : 0) |
+        (FsvolDeviceExtension->VolumeParams.HardLinks ? FILE_SUPPORTS_HARD_LINKS : 0) |
         (FsvolDeviceExtension->VolumeParams.ExtendedAttributes ? FILE_SUPPORTS_EXTENDED_ATTRIBUTES : 0) |
         (FsvolDeviceExtension->VolumeParams.ReadOnlyVolume ? FILE_READ_ONLY_VOLUME : 0) |
         (FsvolDeviceExtension->VolumeParams.SupportsPosixUnlinkRename ? FILE_SUPPORTS_POSIX_UNLINK_RENAME : 0);
