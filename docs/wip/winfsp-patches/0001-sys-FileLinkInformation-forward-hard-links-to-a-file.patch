+/*
+ * The number of names a file has: the file system's own count where the volume declares hard links and the file
+ * system reports one; otherwise 1, as before hard links, and always 1 for a directory.
+ */
+static inline ULONG FspFsvolNumberOfLinks(FSP_FILE_NODE *FileNode, const FSP_FSCTL_FILE_INFO *FileInfo)
+{
+    /* a directory has one name, as on NTFS, whatever a POSIX file system counts for it */
+    return !FileNode->IsDirectory &&
+        FspFsvolDeviceExtension(FileNode->FsvolDeviceObject)->VolumeParams.HardLinks &&
+        0 != FileInfo->HardLinks ? FileInfo->HardLinks : 1;
+}
